{
  // Cloudflare Workers, static assets only: no Worker code, no bindings.
  // `npm run deploy:cloudflare` builds and deploys.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bettersilang",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Client-side routes (/districts, /projects/...) serve index.html.
    "not_found_handling": "single-page-application"
  }
}
